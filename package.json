{
  "name": "renato-cruz-portfolio",
  "version": "1.0.0",
  "description": "Modern, responsive portfolio website for Renato Cruz - Full-Stack Web Developer",
  "main": "index.html",
  "scripts": {
    "build-css": "npx tailwindcss -i ./src/input.css -o ./assets/styles.css --minify",
    "watch-css": "npx tailwindcss -i ./src/input.css -o ./assets/styles.css --watch",
    "build": "npm run build-css",
    "start": "npm run watch-css",
    "serve": "npx serve .",
    "deploy": "npm run build-css"
  },
  "keywords": [
    "portfolio",
    "web-developer",
    "responsive",
    "tailwind",
    "javascript"
  ],
  "author": "Renato Cruz",
  "license": "MIT",
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "serve": "^14.2.0",
    "tailwindcss": "^3.4.18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/renato/portfolio"
  },
  "homepage": "https://renatocruz.dev"
}
